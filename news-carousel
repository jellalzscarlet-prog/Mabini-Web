document.addEventListener("DOMContentLoaded", function () {
    const carousel = document.getElementById("newsCarousel");

    if (!carousel) return;

    const slides = carousel.querySelectorAll(".news-slide");
    const dots = carousel.querySelectorAll(".news-dot");
    const prev = document.getElementById("newsPrev");
    const next = document.getElementById("newsNext");

    if (slides.length === 0 || !prev || !next) {
        console.error("Carousel elements are missing.");
        return;
    }

    let currentSlide = 0;

    function showSlide(index) {
        currentSlide = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
            slide.classList.toggle("active", i === currentSlide);
        });

        dots.forEach((dot, i) => {
            dot.classList.toggle("active", i === currentSlide);
        });
    }

    prev.addEventListener("click", () => showSlide(currentSlide - 1));
    next.addEventListener("click", () => showSlide(currentSlide + 1));

    dots.forEach((dot, index) => {
        dot.addEventListener("click", () => showSlide(index));
    });

    showSlide(0);
});